[Unit]
Description=VERT plant-cam (on-device plant-health vision + live view)
Wants=network-online.target
After=network-online.target docker.service
# Restart forever, but not in a tight loop if something is persistently wrong.
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=notify
NotifyAccess=main
User=plantcam
Group=plantcam
SupplementaryGroups=video
WorkingDirectory=/opt/plant-cam/app
ExecStartPre=/opt/plant-cam/venv/bin/python -m plant_cam check-config --config /etc/plant-cam/config.yaml
ExecStart=/opt/plant-cam/venv/bin/python -m plant_cam run --config /etc/plant-cam/config.yaml
# Device secret lives here (mode 600), never in config.yaml.
EnvironmentFile=-/etc/plant-cam/secret.env
Environment=PYTHONUNBUFFERED=1
# One BLAS/OpenMP thread pool per library is plenty; inference threads are set in config.
Environment=OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1

# Restarted on crash, on exit code 1 (camera driver or analysis wedged), and
# by the watchdog if the main loop stops pinging. A clean stop (SIGTERM) is final.
Restart=on-failure
RestartSec=5
WatchdogSec=60
TimeoutStartSec=120
TimeoutStopSec=75

# This Pi also runs the broker and databases: stay polite.
Nice=5
CPUQuota=200%
MemoryHigh=600M
MemoryMax=900M
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# Port 81 is below 1024; grant just that one privilege instead of root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Creates /var/lib/plant-cam owned by plantcam (outbox, history, samples).
StateDirectory=plant-cam
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/plant-cam

[Install]
WantedBy=multi-user.target
